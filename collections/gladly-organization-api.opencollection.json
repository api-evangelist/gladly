{
  "opencollection": "1.0.0",
  "info": {
    "name": "Gladly Agents Organization API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Organization",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get Organization",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{organization}.gladly.com/api/v1/api/v1/organization"
          },
          "docs": "Returns metadata about your organization.\n"
        }
      ]
    }
  ],
  "bundled": true
}