        {
          "id": "4897c23a-584e-4a17-8b06-147e2b2457d6",
          "name": "List Jobs",
          "request": {
            "name": "List Jobs",
            "description": {
              "content": "List all jobs for the organization in any status for the last 14 days. \n```\n/api/v1/export/jobs\n```\n\nYou can further filter the results by including query parameters for `status`, `startAt`, and `endAt`.\n```\n/api/v1/export/jobs?status=COMPLETED&startAt=2024-09-15T00:00:00.000Z&endAt=2024-09-16T00:00:00.000Z\n```\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v1",
                "export",
                "jobs"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "status",
                  "value": "<string>",
                  "description": "export job status to search on."
                },
                {
                  "disabled": false,
                  "key": "startAt",
                  "value": "<ISO 8601>",
                  "description": "Starting time to filter export jobs by. This is based on the `updatedAt` field which indicates when the job was last updated. Cannot be more than 14 days ago. Default is 14 days ago.\n\nThe date should be in ISO 8601 format.\n"
                },
                {
                  "disabled": false,
                  "key": "endAt",
                  "value": "<ISO 8601>",
                  "description": "Ending time to filter export jobs by. This is based on the `updatedAt` field which indicates when the job was last updated. Cannot be before 'startAt' or in the future. Default is now.\n\nThe date should be in ISO 8601 format.\n"
                }
              ],
              "variable": [
                {
                  "description": "Your Gladly organization subdomain",
                  "type": "any",
                  "value": "{{organization}}",
                  "key": "organization"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
          "response": [
